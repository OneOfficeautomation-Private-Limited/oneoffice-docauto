# Local settings for Oneoffice Document Automation (read by windows\start.ps1).
# Edit with windows\configure.ps1 or any text editor. Never commit real keys.

# --- deployment ---------------------------------------------------------
DOCAUTO_PROFILE=onprem_hybrid
DOCAUTO_PORT=8085
DOCAUTO_API_TOKEN=
DOCAUTO_DATA_DIR=./data

# --- storage --------------------------------------------------------------
# PostgreSQL. Empty = an embedded PostgreSQL 16 in <data dir>\postgres (no set-up needed).
# Example: postgresql://docflow:secret@dbserver:5432/docflow (the database must use UTF8)
DOCAUTO_DATABASE_URL=
# Fernet key that encrypts stored documents. Empty = generated into <data dir>\file.key on first start
# (back that file up). Several keys, comma separated, rotate: the first encrypts, all decrypt.
DOCAUTO_FILE_KEY=
# Documents older than this many days are deleted daily (0 = keep forever)
DOCAUTO_RETENTION_DAYS=30

# --- option packs -------------------------------------------------------
DOCAUTO_PACK_OPENSOURCE=true
DOCAUTO_PACK_CLOUD=true
DOCAUTO_PACK_AI=true

# --- defaults -----------------------------------------------------------
DOCAUTO_DEFAULT_OCR=tesseract
DOCAUTO_DEFAULT_EXTRACTION=builtin-rules

# --- routing (OCR strategy plan: local first, cloud only with opt-in) ----
DOCAUTO_CLOUD_OPT_IN=false
DOCAUTO_ESCALATE_THRESHOLD=0.85
DOCAUTO_RETRY_LOCAL=paddleocr
DOCAUTO_ESCALATE_TO=
# mask national IDs / Iqama, IBANs, phones and e-mails before cloud AI models (page images are then not sent)
DOCAUTO_MASK_PII=true

# --- option 1: open source ----------------------------------------------
TESSERACT_CMD=
TESSDATA_PREFIX=

# --- option 2: licensed / cloud -----------------------------------------
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_REGION=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GCP_PROJECT=
DOCAI_LOCATION=eu
DOCAI_OCR_PROCESSOR=
DOCAI_FORM_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# --- option 3: AI extraction --------------------------------------------
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_ESCALATION_MODEL=claude-sonnet-5-5
CLAUDE_SEND_IMAGES=true
CLAUDE_REGION=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REGION=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
